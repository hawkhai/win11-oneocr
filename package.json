{
  "name": "dsh-win11-oneocr",
  "version": "0.1.1",
  "description": "Offline OneOCR with native C++ and JavaScript/WebAssembly backends and an optional Windows legacy adapter. Cross-platform validation is incomplete.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./wasm": { "types": "./artifacts/wasm32/oneocr.d.mts", "default": "./artifacts/wasm32/oneocr.mjs" },
    "./wasm/worker": { "types": "./artifacts/wasm32/worker-client.d.mts", "default": "./artifacts/wasm32/worker-client.mjs" }
  },
  "files": [
    "src",
    "examples/wasm",
    "artifacts/*/bin/**",
    "artifacts/*/lib/**",
    "artifacts/*/share/**",
    "artifacts/wasm32/*.mjs",
    "artifacts/wasm32/*.wasm",
    "artifacts/wasm32/*.d.mts",
    "artifacts/wasm32/BUILD.json",
    "native/include",
    "cordis.patch.yml",
    "README.md",
    "docs/portable.md",
    "docs/error-codes.md",
    "docs/wasm.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/onnxruntime-LICENSE.txt",
    "licenses/onnxruntime-ThirdPartyNotices.txt",
    "licenses/icu-Unicode-3.0.txt",
    "licenses/gcc-runtime-copyright.txt",
    "licenses/gcc-runtime-GPL-3.txt",
    "licenses/msvc-runtime-notice.txt",
    "licenses/opencv-Apache-2.0.txt",
    "licenses/opencv-softfloat-fdlibm.txt",
    "licenses/opencv-zlib.txt",
    "licenses/nlohmann-json-MIT.txt"
  ],
  "scripts": {
    "test": "node test/standalone-test.mjs",
    "test:wasm": "node test/wasm-test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ocr",
    "oneocr",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkhai/win11-oneocr.git"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
