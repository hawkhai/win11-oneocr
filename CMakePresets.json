{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    { "name": "base", "hidden": true, "binaryDir": "${sourceDir}/build/${presetName}", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ONEOCR_BUILD_PORTABLE": "ON", "ONEOCR_BUILD_LEGACY": "OFF", "ONNXRUNTIME_ROOT": "$env{ONNXRUNTIME_ROOT}" } },
    { "name": "windows-x64", "inherits": "base", "generator": "Visual Studio 17 2022", "architecture": "x64" },
    { "name": "linux-x64", "inherits": "base", "generator": "Ninja" },
    { "name": "linux-arm64", "inherits": "base", "generator": "Ninja", "cacheVariables": { "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++", "CMAKE_SYSTEM_NAME": "Linux", "CMAKE_SYSTEM_PROCESSOR": "aarch64" } },
    { "name": "macos-x64", "inherits": "base", "generator": "Ninja", "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64" } },
    { "name": "macos-arm64", "inherits": "base", "generator": "Ninja", "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" } },
    { "name": "android-arm64", "inherits": "base", "generator": "Ninja", "toolchainFile": "${sourceDir}/cmake/toolchains/android-arm64.cmake", "cacheVariables": { "BUILD_TESTING": "OFF", "ONEOCR_BUILD_JNI": "ON" } }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "linux-x64", "configurePreset": "linux-x64" },
    { "name": "linux-arm64", "configurePreset": "linux-arm64" },
    { "name": "macos-x64", "configurePreset": "macos-x64" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "android-arm64", "configurePreset": "android-arm64" }
  ]
}
