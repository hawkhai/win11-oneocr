set(ONEOCR_OPENCV_SOURCE "${PROJECT_SOURCE_DIR}/work/vendor/opencv" CACHE PATH "Pinned OpenCV 4.10.0 source")
if(NOT EXISTS "${ONEOCR_OPENCV_SOURCE}/CMakeLists.txt")
    message(FATAL_ERROR "Run python scripts/fetch-opencv.py, or set ONEOCR_OPENCV_SOURCE to the pinned source checkout")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -c "safe.directory=${ONEOCR_OPENCV_SOURCE}" -C "${ONEOCR_OPENCV_SOURCE}" rev-parse HEAD OUTPUT_VARIABLE ONEOCR_OPENCV_REV OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE ONEOCR_OPENCV_RESULT)
if(NOT ONEOCR_OPENCV_RESULT EQUAL 0 OR NOT ONEOCR_OPENCV_REV STREQUAL "71d3237a093b60a27601c20e9ee6c3e52154e8b1")
    message(FATAL_ERROR "OpenCV source must match 71d3237a093b60a27601c20e9ee6c3e52154e8b1")
endif()
set(BUILD_LIST "core,imgproc" CACHE STRING "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_WITH_STATIC_CRT OFF CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_PERF_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BUILD_opencv_apps OFF CACHE BOOL "" FORCE)
set(BUILD_opencv_python3 OFF CACHE BOOL "" FORCE)
set(BUILD_JAVA OFF CACHE BOOL "" FORCE)
set(WITH_IPP OFF CACHE BOOL "" FORCE)
set(WITH_ITT OFF CACHE BOOL "" FORCE)
set(WITH_OPENCL OFF CACHE BOOL "" FORCE)
set(WITH_LAPACK OFF CACHE BOOL "" FORCE)
set(WITH_EIGEN OFF CACHE BOOL "" FORCE)
set(WITH_PROTOBUF OFF CACHE BOOL "" FORCE)
if(EMSCRIPTEN)
    file(READ "${ONEOCR_OPENCV_SOURCE}/modules/core/include/opencv2/core/hal/intrin_wasm.hpp" ONEOCR_WASM_INTRINSICS)
    string(FIND "${ONEOCR_WASM_INTRINSICS}" "OneOCR: SSE nearest-even" ONEOCR_WASM_ROUNDING)
    if(ONEOCR_WASM_ROUNDING LESS 0)
        message(FATAL_ERROR "Prepare the pinned Wasm rounding adjustment with scripts/build-wasm.py; see docs/wasm.md")
    endif()
    set(WITH_PTHREADS_PF OFF CACHE BOOL "" FORCE)
    set(WITH_OPENMP OFF CACHE BOOL "" FORCE)
    set(WITH_TBB OFF CACHE BOOL "" FORCE)
endif()
foreach(feature GAPI FFMPEG GSTREAMER VTK JPEG PNG TIFF WEBP OPENJPEG JASPER OPENEXR)
    set(WITH_${feature} OFF CACHE BOOL "" FORCE)
endforeach()
set(BUILD_opencv_gapi OFF CACHE BOOL "" FORCE)
set(WITH_ADE OFF CACHE BOOL "" FORCE)
set(BUILD_opencv_videoio OFF CACHE BOOL "" FORCE)
set(OPENCV_DOWNLOAD_PATH "${CMAKE_BINARY_DIR}/opencv-downloads" CACHE PATH "" FORCE)
set(OPENCV_ENABLE_NONFREE OFF CACHE BOOL "" FORCE)
set(OPENCV_FORCE_3RDPARTY_BUILD OFF CACHE BOOL "" FORCE)
set(CPU_DISPATCH "" CACHE STRING "" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
add_subdirectory("${ONEOCR_OPENCV_SOURCE}" "${CMAKE_BINARY_DIR}/opencv" EXCLUDE_FROM_ALL)
