# Common contains ICU's bidi and dictionary word-break engines; i18n is not used.
set(ONEOCR_ICU_SOURCE "${PROJECT_SOURCE_DIR}/work/vendor/icu-source" CACHE PATH "Pinned ICU 74.2 source")
set(ONEOCR_ICU_DATA_C "${PROJECT_SOURCE_DIR}/work/icu-generated/icudt74l_dat.c" CACHE FILEPATH "ICU data generated from the pinned source")
execute_process(COMMAND "${GIT_EXECUTABLE}" -c "safe.directory=${ONEOCR_ICU_SOURCE}" -C "${ONEOCR_ICU_SOURCE}" rev-parse HEAD OUTPUT_VARIABLE ONEOCR_ICU_REV OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE ONEOCR_ICU_RESULT)
if(NOT ONEOCR_ICU_RESULT EQUAL 0 OR NOT ONEOCR_ICU_REV STREQUAL "2d029329c82c7792b985024b2bdab5fc7278fbc8")
    message(FATAL_ERROR "ICU source must match 2d029329c82c7792b985024b2bdab5fc7278fbc8; run scripts/prepare-icu.py")
endif()
if(NOT EXISTS "${ONEOCR_ICU_DATA_C}")
    message(FATAL_ERROR "Generate ICU's source data with scripts/prepare-icu.py before configuring")
endif()
set(ONEOCR_ICU_COMMON "${ONEOCR_ICU_SOURCE}/icu4c/source/common")
file(STRINGS "${ONEOCR_ICU_COMMON}/sources.txt" ONEOCR_ICU_SOURCES)
list(TRANSFORM ONEOCR_ICU_SOURCES PREPEND "${ONEOCR_ICU_COMMON}/")
add_library(oneocr_icu_data STATIC "${ONEOCR_ICU_DATA_C}")
target_include_directories(oneocr_icu_data PRIVATE "${ONEOCR_ICU_COMMON}")
target_compile_definitions(oneocr_icu_data PRIVATE U_STATIC_IMPLEMENTATION)
add_library(oneocr_icu_common STATIC ${ONEOCR_ICU_SOURCES})
target_include_directories(oneocr_icu_common PUBLIC "${ONEOCR_ICU_COMMON}")
target_compile_definitions(oneocr_icu_common PUBLIC U_STATIC_IMPLEMENTATION PRIVATE U_COMMON_IMPLEMENTATION U_ENABLE_DYLOAD=0)
target_link_libraries(oneocr_icu_common PUBLIC oneocr_icu_data)
if(WIN32)
    target_link_libraries(oneocr_icu_common PRIVATE advapi32)
else()
    find_package(Threads REQUIRED)
    target_link_libraries(oneocr_icu_common PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
endif()
if(MSVC)
    target_compile_options(oneocr_icu_common PRIVATE /utf-8 /EHsc /wd4996)
endif()
